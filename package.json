    "submenus": [
      {
        "id": "playwrightStudio.editorContext",
        "label": "Playwright Studio"
      },
      {
        "id": "playwrightStudio.explorerContext",
        "label": "Playwright Studio"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "playwrightSnippets.runTestAtCursor",
          "when": "editorTextFocus && resourceFilename =~ /\\.(spec|test)\\.[cm]?[jt]sx?$/",
          "group": "playwright@1"
        },
        {
          "command": "playwrightSnippets.inspectTestAtCursor",
          "when": "editorTextFocus && resourceFilename =~ /\\.(spec|test)\\.[cm]?[jt]sx?$/",
          "group": "playwright@2"
        },
        {
          "submenu": "playwrightStudio.editorContext",
          "when": "editorTextFocus && resourceFilename =~ /\\.(spec|test)\\.[cm]?[jt]sx?$/",
          "group": "playwright@3"
        }
      ],
      "playwrightStudio.editorContext": [
        {
          "command": "playwrightSnippets.runWithTag",
          "group": "1_run@1"
        },
        {
          "command": "playwrightSnippets.runWithProject",
          "group": "1_run@2"
        },
        {
          "command": "playwrightSnippets.codeGen",
          "group": "2_tools@1"
        },
        {
          "command": "playwrightSnippets.showReport",
          "group": "2_tools@2"
        },
        {
          "command": "playwrightSnippets.showTrace",
          "group": "2_tools@3"
        },
        {
          "command": "playwrightSnippets.saveAsSnippet",
          "when": "editorHasSelection",
          "group": "3_snippet@1"
        }
      ],
      "explorer/context": [
        {
          "command": "playwrightSnippets.runFile",
          "when": "resourceFilename =~ /\\.(spec|test)\\.[cm]?[jt]sx?$/",
          "group": "playwright@1"
        },
        {
          "command": "playwrightSnippets.inspectFile",
          "when": "resourceFilename =~ /\\.(spec|test)\\.[cm]?[jt]sx?$/",
          "group": "playwright@2"
        },
        {
          "submenu": "playwrightStudio.explorerContext",
          "when": "resourceFilename =~ /\\.(spec|test)\\.[cm]?[jt]sx?$/",
          "group": "playwright@3"
        }
      ],
      "playwrightStudio.explorerContext": [
        {
          "command": "playwrightSnippets.debugFile",
          "group": "1_run@1"
        },
        {
          "command": "playwrightSnippets.debugInspectFile",
          "group": "1_run@2"
        },
        {
          "command": "playwrightSnippets.runWithProject",
          "group": "1_run@3"
        },
        {
          "command": "playwrightSnippets.showReport",
          "group": "2_tools@1"
        }
      ],
      "view/title": [
        {
          "command": "playwrightSnippets.showReport",
          "when": "view == playwrightStudio.resultsView",
          "group": "navigation"
        },
        {
          "command": "playwrightSnippets.showAnalytics",
          "when": "view == playwrightStudio.historyView",
          "group": "navigation@1"
        },
        {
          "command": "playwrightSnippets.clearHistory",
          "when": "view == playwrightStudio.historyView",
          "group": "navigation@2"
        },
        {
          "command": "playwrightSnippets.openIntelligence",
          "when": "view == playwrightStudio.historyView",
          "group": "navigation"
        },
        {
          "command": "playwrightSnippets.runExplorerTests",
          "when": "view == playwrightStudio.testsView",
          "group": "navigation@1"
        },
        {
          "command": "playwrightSnippets.debugExplorerTests",
          "when": "view == playwrightStudio.testsView",
          "group": "navigation@2"
        },
        {
          "command": "playwrightSnippets.refreshTests",
          "when": "view == playwrightStudio.testsView",
          "group": "navigation@4"
        },
        {
          "command": "playwrightSnippets.openIntelligence",
          "when": "view == playwrightStudio.testsView",
          "group": "navigation@5"
        },
        {
          "command": "playwrightSnippets.openFeatureCatalog",
          "when": "view == playwrightStudio.featuresView",
          "group": "navigation"
        },
        {
          "command": "playwrightSnippets.inspectExplorerTests",
          "when": "view == playwrightStudio.testsView",
          "group": "navigation@3"
        },
        {
          "command": "playwrightSnippets.openSelectorIntelligence",
          "when": "view == playwrightStudio.testsView",
          "group": "navigation@6"
        }
      ],
      "view/item/context": [
        {
          "command": "playwrightSnippets.showTrace",
          "when": "view == playwrightStudio.resultsView && viewItem == playwrightSpecWithTrace",
          "group": "inline"
        },
        {
          "command": "playwrightSnippets.runExplorerTests",
          "when": "view == playwrightStudio.testsView && viewItem == playwrightStudioTest",
          "group": "inline@1"
        },
        {
          "command": "playwrightSnippets.debugExplorerTests",
          "when": "view == playwrightStudio.testsView && viewItem == playwrightStudioTest",
          "group": "inline@2"
        },
        {
          "command": "playwrightSnippets.inspectExplorerTests",
          "when": "view == playwrightStudio.testsView && viewItem == playwrightStudioTest",
          "group": "inline@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "playwrightSnippets.runTestAtCursor",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorTextFocus && resourceFilename =~ /\\.(spec|test)\\.[cm]?[jt]sx?$/"
      },
      {
        "command": "playwrightSnippets.runWithTag",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t",
        "when": "editorTextFocus && resourceFilename =~ /\\.(spec|test)\\.[cm]?[jt]sx?$/"
      }
    ],
    "configuration": {
      "title": "Playwright Studio",
      "properties": {
        "playwrightSnippets.workingDirectory": {
          "type": "string",
          "scope": "resource",
          "default": "",
          "description": "Working directory for running Playwright tests (relative to workspace root, or absolute). Detected from the nearest playwright.config file; falls back to the workspace root."
        },
        "playwrightSnippets.testCommand": {
          "type": "string",
          "scope": "resource",
          "default": "npx playwright test",
          "description": "Executable and arguments used to run Playwright tests. Quotes are supported; shell operators and expansion are intentionally not executed."
        },
        "playwrightSnippets.toolCommand": {
          "type": "string",
          "scope": "resource",
          "default": "",
          "description": "Optional Playwright command prefix for Codegen, Trace Viewer, and HTML Report (for example, pnpm exec playwright). Leave empty to derive it from testCommand."
        },
        "playwrightSnippets.reportPath": {
          "type": "string",
          "scope": "resource",
          "default": "",
          "description": "Optional HTML report directory passed to playwright show-report. Relative paths are resolved from workingDirectory. Leave empty for Playwright's default playwright-report directory."
        },
        "playwrightSnippets.reporter": {
          "type": "string",
          "scope": "resource",
          "default": "",
          "description": "Optional comma-separated Playwright reporters to pass on the command line (e.g. list,html). Leave empty to use the Playwright config. When result capture is enabled, json is appended to this list."
        },
        "playwrightSnippets.env": {
          "type": "object",
          "scope": "resource",
          "default": {},
          "description": "Additional environment variables to set when running tests.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "playwrightSnippets.envFile": {
          "type": "string",
          "scope": "resource",
          "default": "",
          "description": "Optional .env file loaded before configured environment variables. Relative paths are resolved from workingDirectory; values are never displayed by the extension."
        },
        "playwrightSnippets.captureResults": {
          "type": "boolean",
          "scope": "resource",
          "default": true,
          "description": "Capture results automatically for extension runs. Adds the JSON reporter at runtime while retaining configured reporters; no config-file edits are needed."
        },
        "playwrightSnippets.envProfiles": {
          "type": "object",
          "scope": "resource",
          "default": {},
          "description": "Named environment profiles. Each key is a profile name and its value is a map of env vars applied when that profile is active. Switch profiles via the status bar or 'Playwright Studio: Switch Environment Profile'.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "examples": [
            {
              "staging": {
                "BASE_URL": "https://staging.example.com"
              },
              "production": {
                "BASE_URL": "https://example.com"
              }
            }
          ]
        },
        "playwrightSnippets.heatmapThresholdDays": {
          "type": "number",
          "scope": "resource",
          "default": 7,
          "minimum": 1,
          "description": "Number of days after which a test is highlighted as 'cold' (never or rarely run) in the coverage heatmap."
        },
        "playwrightSnippets.historyLimit": {
          "type": "number",
          "scope": "resource",
          "default": 50,
          "minimum": 1,
          "maximum": 500,
          "description": "Maximum number of captured Playwright runs retained per Playwright root in extension storage."
        },
        "playwrightSnippets.runPresets": {
          "type": "array",
          "scope": "resource",
          "default": [],
          "description": "Named run-matrix presets. Presets can also be created through 'Run with Matrix Options'.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "scope"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "scope": {
                "type": "string",
                "enum": [
                  "workspace",
                  "file"
                ]
              },
              "projects": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "grep": {
                "type": "string"
              },
              "headed": {
                "type": "boolean"
              },
              "trace": {
                "type": "string",
                "enum": [
                  "on",
                  "off",
                  "retain-on-failure",
                  "on-first-retry"
                ]
              },
              "workers": {
                "type": "number",
                "minimum": 1
              },
              "retries": {
                "type": "number",
                "minimum": 0
              },
              "repeatEach": {
                "type": "number",
                "minimum": 1
              },
              "lastFailed": {
                "type": "boolean"
              },
              "envProfile": {
                "type": "string"
              },
              "timeout": {
                "type": "number",
                "minimum": 0
              },
              "maxFailures": {
                "type": "number",
                "minimum": 0
              },
              "grepInvert": {
                "type": "string"
              },
              "shard": {
                "type": "string",
                "pattern": "^[0-9]+/[0-9]+$"
              },
              "updateSnapshots": {
                "type": "string",
                "enum": [
                  "changed",
                  "missing",
                  "all",
                  "none"
                ]
              },
              "fullyParallel": {
                "type": "boolean"
              },
              "forbidOnly": {
                "type": "boolean"
              },
              "failOnFlakyTests": {
                "type": "boolean"
              },
              "onlyChanged": {
                "type": "boolean"
              },
              "video": {
                "type": "string",
                "enum": [
                  "off",
                  "on",
                  "retain-on-failure",
                  "on-first-retry"
                ]
              }
            }
          }
        },
        "playwrightSnippets.uiHost": {
          "type": "string",
          "scope": "resource",
          "default": "",
          "description": "Optional host passed to Playwright UI Mode."
        },
        "playwrightSnippets.uiPort": {
          "type": "number",
          "scope": "resource",
          "default": 0,
          "minimum": 0,
          "maximum": 65535,
          "description": "Optional port passed to Playwright UI Mode; 0 lets Playwright choose."
        },
        "playwrightSnippets.componentGalleryUrl": {
          "type": "string",
          "scope": "resource",
          "default": "http://localhost:3100",
          "description": "URL opened by the Component Testing Gallery command."
        },
        "playwrightSnippets.intelligenceRunTimeoutMs": {
          "type": "number",
          "default": 180000,
          "minimum": 1000,
          "maximum": 3600000,
          "scope": "resource",
          "description": "Maximum duration of each isolated Intelligence execution before cancellation."
        },
        "playwrightSnippets.selectorBrowserChannel": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "chrome",
            "msedge"
          ],
          "description": "Browser for Selector Intelligence. Automatic tries Playwright Chromium, then installed Chrome and Edge if the browser executable is missing. Select a channel to use only that browser."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "playwrightStudio.getStarted",
        "title": "Get started with Playwright Studio",
        "description": "Run Playwright tests, generate code, and inspect failures without leaving VS Code.",
        "steps": [
          {
            "id": "playwrightStudio.checkSetup",
            "title": "Check your Playwright project",
            "description": "Open a trusted project with Playwright installed and a playwright.config file. Studio uses your existing configuration.\n[Check project setup](command:playwrightSnippets.healthCheck)",
            "media": {
              "image": "images/walkthrough-run.svg",
              "altText": "Check a Playwright project before running a test"
            },
            "completionEvents": [
              "onCommand:playwrightSnippets.healthCheck"
            ]
          },
          {
            "id": "playwrightStudio.runTest",
            "title": "Run a test from the editor",
            "description": "Open a .spec.ts or .test.ts file and click Run above a test. Studio captures results automatically.\n[Run the current test file](command:playwrightSnippets.runFile)",
            "media": {
              "image": "images/walkthrough-run.svg",
              "altText": "Playwright Studio run test walkthrough"
            },
            "completionEvents": [
              "onCommand:playwrightSnippets.runTest",
              "onCommand:playwrightSnippets.runFile",
              "onCommand:playwrightSnippets.runTestAtCursor"
            ]
          },
          {
            "id": "playwrightStudio.codegen",
            "title": "Generate Playwright code",
            "description": "Record interactions with Playwright Codegen, or type p- in a JavaScript or TypeScript file to browse snippets.\n[Open Codegen](command:playwrightSnippets.codeGen)",
            "media": {
              "image": "images/walkthrough-codegen.svg",
              "altText": "Playwright Studio codegen walkthrough"
            },
            "completionEvents": [
              "onCommand:playwrightSnippets.codeGen"
            ]
          },
          {
            "id": "playwrightStudio.trace",
            "title": "Open traces and reports",
            "description": "Open Results to inspect a failure and its attachments. Trace Viewer is available when your run captured a trace.\n[Open a trace](command:playwrightSnippets.showTrace)",
            "media": {
              "image": "images/walkthrough-trace.svg",
              "altText": "Playwright Studio trace viewer walkthrough"
            },
            "completionEvents": [
              "onCommand:playwrightSnippets.showTrace",
              "onCommand:playwrightSnippets.showReport"
            ]
          }
        ]
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "**/.playwright-studio/studio.json",
        "url": "./schemas/studio.schema.json"
      },
      {
        "fileMatch": "**/.playwright-studio/lab.json",
        "url": "./schemas/lab.schema.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "playwrightStudio",
          "title": "Playwright Studio",
          "icon": "images/playwright-studio-activity.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "playwrightStudio.testsView",
        "contents": "Open a folder with Playwright tests to get started.\n[Open Folder](command:vscode.openFolder)\n[Browse all features](command:playwrightSnippets.openFeatureCatalog)",
        "when": "workspaceFolderCount == 0"
      },
      {
        "view": "playwrightStudio.testsView",
        "contents": "No Playwright tests found yet. Open a project containing a playwright.config file and a .spec.ts or .test.ts file.\n[Check project setup](command:playwrightSnippets.healthCheck)\n[Refresh tests](command:playwrightSnippets.refreshTests)\n[Read setup guide](command:playwrightSnippets.openFeatureCatalog)",
        "when": "workspaceFolderCount > 0"
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.js",
    "compile:prod": "node esbuild.js --production",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test:snippets": "node --test test/snippets.test.js",
    "test:runtime": "esbuild test/runtime.test.ts --bundle --platform=node --format=cjs --outfile=.test-dist/runtime.test.js && node --test .test-dist/runtime.test.js",
    "test:integration": "npm run compile:prod && esbuild test/integration/index.ts --bundle --platform=node --format=cjs --external:vscode --outfile=.test-dist/integration/index.js && node test/run-integration.js",
    "test": "npm run check:features && npm run test:snippets && npm run test:runtime && npm run test:commands && npm run test:intelligence && npm run test:lab && npm run test:security && npm run test:production && npm run test:selectors && npm run test:storage",
    "package": "npm run compile:prod && vsce package",
    "build": "npm run package",
    "test:commands": "esbuild test/commands.test.ts --bundle --platform=node --format=cjs --alias:vscode=./test/vscodeMock.ts --outfile=.test-dist/commands.test.js && node --test .test-dist/commands.test.js",
    "test:intelligence": "esbuild test/intelligence.test.ts --bundle --platform=node --format=cjs --outfile=.test-dist/intelligence.test.js && node --test .test-dist/intelligence.test.js",
    "test:experiments": "npm run compile:prod && esbuild test/experiments.test.ts --bundle --external:playwright/package.json --platform=node --format=cjs --outfile=.test-dist/experiments.test.js && node --test .test-dist/experiments.test.js",
    "test:browser": "npm run compile:prod && esbuild test/browser.test.ts --bundle --external:playwright/package.json --external:@playwright/test --alias:vscode=./test/vscodeMock.ts --platform=node --format=cjs --outfile=.test-dist/browser.test.js && node --test .test-dist/browser.test.js",
    "test:lab": "esbuild test/lab.test.ts --bundle --platform=node --format=cjs --alias:vscode=./test/vscodeMock.ts --outfile=.test-dist/lab.test.js && node --test .test-dist/lab.test.js",
    "test:lab-experiments": "npm run compile:prod && esbuild test/lab-experiments.test.ts --bundle --platform=node --format=cjs --external:playwright/package.json --alias:vscode=./test/vscodeMock.ts --outfile=.test-dist/lab-experiments.test.js && node --test .test-dist/lab-experiments.test.js",
    "test:lab-browser": "npm run compile:prod && esbuild test/lab-browser.test.ts --bundle --platform=node --format=cjs --external:playwright/package.json --alias:vscode=./test/vscodeMock.ts --outfile=.test-dist/lab-browser.test.js && node --test .test-dist/lab-browser.test.js",
    "docs:features": "node scripts/build-feature-catalog.js",
    "check:features": "node scripts/build-feature-catalog.js --check",
    "prepackage": "npm run check:features",
    "test:security": "esbuild test/security.test.ts --bundle --platform=node --format=cjs --alias:vscode=./test/vscodeMock.ts --outfile=.test-dist/security.test.js && node --test .test-dist/security.test.js",
    "test:production": "esbuild test/production.test.ts --bundle --platform=node --format=cjs --alias:vscode=./test/vscodeMock.ts --outfile=.test-dist/production.test.js && node --test .test-dist/production.test.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/*.js\" esbuild.js",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/*.js\" esbuild.js",
    "test:selectors": "esbuild test/selectors.test.ts test/selector-startup.test.ts test/selector-session.test.ts --bundle --platform=node --format=cjs --alias:vscode=./test/vscodeMock.ts --outdir=.test-dist && node --test .test-dist/selectors.test.js .test-dist/selector-startup.test.js .test-dist/selector-session.test.js",
    "test:selector-browser": "npm run compile:prod && esbuild test/selector-browser.test.ts --bundle --platform=node --format=cjs --external:@playwright/test --outfile=.test-dist/selector-browser.test.js && node --test .test-dist/selector-browser.test.js",
    "test:selector-devtools": "esbuild test/selector-devtools.test.ts --bundle --platform=node --format=cjs --external:@playwright/test --outfile=.test-dist/selector-devtools.test.js && node --test .test-dist/selector-devtools.test.js",
    "test:storage": "esbuild test/studio-storage.test.ts --bundle --platform=node --format=cjs --outfile=.test-dist/studio-storage.test.js && node --test .test-dist/studio-storage.test.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "cross-spawn": "^7.0.6",
    "esbuild": "^0.25.0",
    "jsonc-parser": "^3.3.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Playwright tools execute workspace tests, configuration and dependencies. Trust the workspace before enabling Studio."
    }
  }
}
