{
  "name": "playwright-test-code-snippets",
  "displayName": "Playwright Studio: Test Runner & Snippets",
  "license": "MIT",
  "author": "Sumanth T P",
  "publisher": "sumanthtps",
  "description": "Run and debug Playwright tests in VS Code. Save run presets, review traces and screenshots, track test history, and write faster with 338 JS/TS snippets.",
  "homepage": "https://github.com/sumanthtps/playwright-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/sumanthtps/playwright-studio.git"
  },
  "bugs": "https://github.com/sumanthtps/playwright-studio/issues",
  "icon": "images/playwright-logo.png",
  "galleryBanner": {
    "color": "#0f6b44",
    "theme": "dark"
  },
  "version": "2.0.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Testing",
    "Snippets",
    "Debuggers"
  ],
  "keywords": [
    "playwright",
    "playwright test",
    "test runner",
    "test explorer",
    "playwright snippets",
    "e2e testing",
    "test automation",
    "debugger",
    "trace viewer",
    "screenshots",
    "test history",
    "run presets",
    "flaky tests",
    "javascript",
    "typescript"
  ],
  "markdown": "github",
  "qna": "marketplace",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact",
    "onView:playwrightStudio.resultsView",
    "onView:playwrightStudio.historyView",
    "onView:playwrightStudio.componentsView",
    "onView:playwrightStudio.annotationsView",
    "workspaceContains:**/playwright.config.ts",
    "workspaceContains:**/playwright.config.js",
    "workspaceContains:**/playwright.config.mts",
    "workspaceContains:**/playwright.config.mjs",
    "workspaceContains:**/playwright.config.cts",
    "workspaceContains:**/playwright.config.cjs",
    "onView:playwrightStudio.testsView"
  ],
  "contributes": {
    "snippets": [
      {
        "language": "javascript",
        "path": "./snippets/playwright.json"
      },
      {
        "language": "javascriptreact",
        "path": "./snippets/playwright.json"
      },
      {
        "language": "typescript",
        "path": "./snippets/playwright.json"
      },
      {
        "language": "typescriptreact",
        "path": "./snippets/playwright.json"
      }
    ],
    "views": {
      "playwrightStudio": [
        {
          "id": "playwrightStudio.testsView",
          "name": "Tests",
          "icon": "images/playwright-studio-activity.svg",
          "contextualTitle": "Playwright Studio"
        },
        {
          "id": "playwrightStudio.resultsView",
          "name": "Results",
          "icon": "images/playwright-studio-activity.svg",
          "when": "workspaceFolderCount > 0",
          "contextualTitle": "Playwright Studio"
        },
        {
          "id": "playwrightStudio.historyView",
          "name": "History",
          "icon": "images/playwright-studio-activity.svg",
          "when": "workspaceFolderCount > 0",
          "contextualTitle": "Playwright Studio"
        },
        {
          "id": "playwrightStudio.componentsView",
          "name": "Components",
          "icon": "images/playwright-studio-activity.svg",
          "when": "workspaceFolderCount > 0",
          "contextualTitle": "Playwright Studio"
        },
        {
          "id": "playwrightStudio.annotationsView",
          "name": "Annotations",
          "icon": "images/playwright-studio-activity.svg",
          "when": "workspaceFolderCount > 0",
          "contextualTitle": "Playwright Studio"
        },
        {
          "id": "playwrightStudio.featuresView",
          "name": "Features",
          "icon": "images/playwright-studio-activity.svg",
          "contextualTitle": "Playwright Studio",
          "visibility": "collapsed"
        }
      ]
