{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Playwright Studio Intelligence",
  "type": "object",
  "required": [
    "version",
    "promises",
    "scenarios",
    "journeys",
    "coverage"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "promises": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "owner",
          "priority",
          "tests",
          "maxAgeDays"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "enum": [
              "critical",
              "normal"
            ]
          },
          "tests": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/testReference"
            }
          },
          "maxAgeDays": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3650
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "urlPattern",
          "latencyMs",
          "offline"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "urlPattern": {
            "type": "string",
            "minLength": 1,
            "description": "Playwright URL glob, e.g. **/api/**."
          },
          "latencyMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 30000
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "offline": {
            "type": "boolean"
          },
          "clock": {
            "type": "string",
            "format": "date-time",
            "description": "Browser time only. Requires an ISO date with timezone."
          }
        }
      }
    },
    "journeys": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "objective",
          "successCriteria",
          "human",
          "agent",
          "model",
          "repetitions"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "successCriteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "human": {
            "$ref": "#/definitions/testReference"
          },
          "agent": {
            "$ref": "#/definitions/testReference"
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "repetitions": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        }
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "test",
          "files",
          "revision"
        ],
        "additionalProperties": false,
        "properties": {
          "test": {
            "$ref": "#/definitions/testReference"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "revision": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "definitions": {
    "testReference": {
      "type": "object",
      "required": [
        "file",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1,
          "description": "Workspace-relative test file."
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "project": {
          "type": "string",
          "minLength": 1
        },
        "titlePath": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Optional suite names followed by the test title, to distinguish duplicate titles."
        }
      }
    }
  }
}
