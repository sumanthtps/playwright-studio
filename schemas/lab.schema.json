{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "branches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "checkpoint": {
            "type": "string",
            "minLength": 1
          },
          "urlPattern": {
            "type": "string",
            "minLength": 1
          },
          "latencyMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 30000
          },
          "status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "releaseAfter": {
            "type": "string",
            "minLength": 1
          },
          "offline": {
            "type": "boolean"
          },
          "clearCookies": {
            "type": "boolean"
          },
          "clock": {
            "type": "string",
            "format": "date-time"
          },
          "pageText": {
            "type": "string",
            "minLength": 1,
            "description": "Synthetic page text injected as text, never executable HTML."
          }
        },
        "required": [
          "id",
          "name",
          "urlPattern",
          "latencyMs"
        ]
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "laws": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "adapter": {
            "type": "string",
            "minLength": 1,
            "description": "Relative module exporting setup, actions, check and cleanup."
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true
          },
          "trials": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "maxSteps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "seed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          }
        },
        "required": [
          "id",
          "statement",
          "adapter",
          "actions",
          "trials",
          "maxSteps",
          "seed"
        ]
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "tunnels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "journeyId": {
            "type": "string",
            "minLength": 1
          },
          "models": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true
          },
          "branches": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "maxItems": 5,
            "uniqueItems": true
          },
          "repetitions": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "forbiddenActions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "maxItems": 100
          }
        },
        "required": [
          "id",
          "journeyId",
          "models",
          "branches",
          "repetitions",
          "forbiddenActions"
        ]
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "incidents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "maxItems": 1000
          },
          "tests": {
            "type": "array",
            "items": {
              "$ref": "studio.schema.json#/definitions/testReference"
            },
            "minItems": 1,
            "maxItems": 1000
          },
          "lawId": {
            "type": "string",
            "minLength": 1
          },
          "capsule": {
            "type": "string",
            "minLength": 1
          },
          "control": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "file": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              },
              "start": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000000
              },
              "end": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000000
              },
              "before": {
                "type": "string",
                "minLength": 1
              },
              "after": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "sourceHash": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "file",
              "line",
              "start",
              "end",
              "before",
              "after",
              "description"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "summary",
          "owner",
          "files",
          "tests"
        ]
      },
      "minItems": 0,
      "maxItems": 1000
    }
  },
  "required": [
    "version",
    "branches",
    "laws",
    "tunnels",
    "incidents"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Playwright Studio Experimental Workflows"
}
